# Runtime
# REQ-DB-002: DB 계정 분리 — READ(BFF 조회) / INGEST(배치 적재) / MIGRATION(DDL).
# Local development may use the docker-compose URLs below.
# Staging/prod must use managed PostgreSQL URLs with per-role credentials; localhost fails readiness preflight.
DATABASE_READ_URL=postgresql://sky_planner_read:sky_planner_read_dev@localhost:5433/sky_planner
DATABASE_INGEST_URL=postgresql://sky_planner_ingest:sky_planner_ingest_dev@localhost:5433/sky_planner
DATABASE_MIGRATION_URL=postgresql://sky_planner_migration:sky_planner_migration_dev@localhost:5433/sky_planner
# Legacy single-URL fallback for seed/ops tooling. Production readiness requires the three role URLs above.
DATABASE_URL=postgresql://sky_planner:sky_planner_dev@localhost:5433/sky_planner
# Staging/prod must keep this true so public APIs return service-unavailable instead of mock fares.
SERVICE_REQUIRE_POSTGRES=true
SOURCE_MAX_STALE_HOURS=24

# Source kill switches
SOURCE_SKYSCANNER_ENABLED=true
SOURCE_KOREAN_AIR_ENABLED=true
SOURCE_ASIANA_ENABLED=true
SOURCE_GOOGLE_FLIGHTS_ENABLED=false
SOURCE_KAYAK_ENABLED=false
SOURCE_PROMO_PAGES_ENABLED=false

# Authorized source manifest. Store the full JSON in the deployment secret.
COLLECTOR_SOURCE_MANIFEST_JSON=

# Partner/API credentials referenced by the manifest token_env fields.
# Production readiness rejects placeholders and values shorter than 16 chars.
SKYSCANNER_FEED_API_KEY=
KOREAN_AIR_FEED_API_KEY=
ASIANA_FEED_API_KEY=

# Revalidation
VERCEL_REVALIDATE_SECRET=

# Operations
OPS_ALERT_WEBHOOK_URL=
OPS_READINESS_TOKEN=
SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=
